config_version=5

[application]
config/name="星环余烬 · Orbit Survivor"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=760
window/size/window_width_override=1440
window/size/window_height_override=977
window/size/mode=2
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.078, 1)
