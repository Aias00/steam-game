extends SceneTree
const Run = preload("res://scripts/run.gd")
func _initialize() -> void:
    for id in Run.ROLES:
        var r = Run.new(Run.ROLES[id][4], 0, 42, id)
        assert(r.health == Run.ROLES[id][1] and r.speed == Run.ROLES[id][2])
        assert(r.weapons[Run.ROLES[id][4]] == 1)
    var assassin = Run.new("orbit", 0, 42, "assassin")
    assassin.spawn_clock = 999
    assassin.dash()
    assassin.dash()
    assert(assassin.effective_dashes == 1 and assassin.assault_timer == 0)
    assassin.step(0.18, Vector2.ZERO)
    assert(is_equal_approx(assassin.assault_timer, 1.2))
    assert(is_equal_approx(assassin.crit_chance("orbit"), 0.25))
    assert(is_equal_approx(assassin.crit_chance("turret"), 0.05))
    assassin.state = "upgrade"
    assassin.step(1, Vector2.ZERO)
    assert(is_equal_approx(assassin.assault_timer, 1.2))
    var robot = Run.new("turret", 0, 42, "robot")
    robot.spawn_clock = 999
    robot.hurt(25)
    assert(robot.shield == 0 and robot.health == 95)
    robot.step(5.9, Vector2.ZERO)
    assert(robot.shield == 0)
    robot.step(0.1, Vector2.ZERO)
    assert(robot.shield == 20)
    robot.loot.append({"pos": robot.player, "value": 4, "heal": true})
    robot.collect_loot(0)
    assert(robot.health == 98)
    var engineer = Run.new("turret", 0, 42, "engineer")
    engineer.spawn_enemy(2, Vector2(100, 0))
    engineer.update_weapons(0)
    assert(engineer.turrets.size() == 1 and engineer.shots.size() == 1)
    assert(is_equal_approx(engineer.shots[0].damage, 24.0))
    engineer.update_weapons(7.1)
    assert(engineer.turrets.is_empty())
    var mapper = Run.new("pulse", 0, 42, "starmapper")
    var enemy = mapper.spawn_enemy(2, Vector2(100, 0))
    mapper.update_mark(0)
    assert(mapper.mark_id == enemy.id)
    mapper.damage_enemy(0, 10, true)
    assert(is_equal_approx(enemy.hp, 95.0 - 18.75))
    mapper.update_mark(4.1)
    assert(mapper.mark_id == -1)
    var ranger = Run.new("pulse", 0, 42, "ranger")
    ranger.spawn_enemy(2, Vector2(300, 0))
    for n in range(4):
        ranger.cooldowns.pulse = 0
        ranger.update_weapons(0)
    assert(ranger.shots[0].pierce == 0 and ranger.shots[3].pierce == 1)
    print("PASS: six roles, recommended weapons, assassin effective dash/pause/crit exclusion, shield recovery/healing, turret attack/lifetime, mark damage/expiry, ranger fourth volley")
    quit()
